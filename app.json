{
  "expo": {
    "name": "Zarfım",
    "slug": "zarfim",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zarfim",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2541"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zarfim.app",
      "appleTeamId": "ZS89AATCJ2",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "12",
      "splash": {
        "backgroundColor": "#1C2541",
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C2541",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "splash": {
        "backgroundColor": "#1C2541",
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain"
      },
      "package": "com.zarfim.app",
      "versionCode": 12,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C2541",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1C2541",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withRNFirebasePodfile",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6930876126004356~7179868350",
          "iosAppId": "ca-app-pub-6930876126004356~3543875674",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
